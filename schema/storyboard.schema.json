{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "required": [
    "meta",
    "style",
    "characters",
    "narration",
    "shots",
    "music",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "logline",
        "language",
        "subtitle_language",
        "audience",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title_native": {
          "type": "string"
        },
        "logline": {
          "type": "string",
          "minLength": 10
        },
        "language": {
          "type": "string",
          "description": "BCP-47 code of the narration, e.g. am"
        },
        "subtitle_language": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "target_duration_s": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "block",
        "present_palette",
        "memory_palette"
      ],
      "additionalProperties": false,
      "properties": {
        "block": {
          "type": "string",
          "description": "Appended to every keyframe prompt to lock the look."
        },
        "present_palette": {
          "type": "string"
        },
        "memory_palette": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "reference_prompt": {
          "type": "string",
          "description": "Prompt for the golden reference image that fixes the look"
        },
        "reference_seed": {
          "type": "integer"
        },
        "reference_image": {
          "type": "string"
        },
        "keyframe_model": {
          "type": "string"
        },
        "keyframe_size": {
          "type": "integer",
          "minimum": 512,
          "maximum": 1536,
          "description": "Square master; cropped to 9:16 and 16:9 in assembly"
        }
      }
    },
    "characters": {
      "type": "object",
      "description": "Character descriptions, re-used verbatim in prompts. Faces are never shown.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "reference_image": {
            "type": "string"
          },
          "real_person": {
            "type": "boolean"
          },
          "consent_ref": {
            "type": "string",
            "description": "Pointer to the consent record in ETHICS.md"
          },
          "sheet_prompt": {
            "type": "string",
            "description": "Prompt for this character's reference sheet"
          },
          "sheet_seed": {
            "type": "integer"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "required": [
        "model",
        "voice",
        "style_instruction"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "fallback_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tried in order when the primary model is out of free daily quota"
        },
        "voice": {
          "type": "string"
        },
        "style_instruction": {
          "type": "string"
        },
        "lead_s": {
          "type": "number",
          "minimum": 0,
          "description": "Silence at the start of a shot before its line begins"
        },
        "tail_s": {
          "type": "number",
          "minimum": 0,
          "description": "Breathing room after a line before the next shot"
        },
        "target_syllables_per_s": {
          "type": "number",
          "minimum": 3,
          "maximum": 15,
          "description": "Lines are time-stretched (pitch-preserving, max ±15%) toward this Ge'ez-syllable rate so the pace is even"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "reason",
          "shot_size",
          "time",
          "characters",
          "image_prompt",
          "motion_prompt",
          "render",
          "seed",
          "min_duration_s",
          "narration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "beat": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists. Every shot must earn its place."
          },
          "shot_size": {
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close",
              "close",
              "extreme_close",
              "insert"
            ]
          },
          "time": {
            "enum": [
              "present",
              "memory",
              "fable"
            ],
            "description": "Selects the palette: present=cool, memory=warm, fable=natural"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_prompt": {
            "type": "string"
          },
          "render": {
            "enum": [
              "wan",
              "kenburns",
              "still"
            ],
            "description": "wan = Wan 2.2 image-to-video, kenburns = FFmpeg zoompan fallback"
          },
          "kenburns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "in",
                  "out",
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              }
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "min_duration_s": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 12
          },
          "transition_in": {
            "enum": [
              "cut",
              "dissolve",
              "fade"
            ]
          },
          "narration": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "text",
              "subtitle"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Narration in meta.language"
              },
              "subtitle": {
                "type": "string",
                "minLength": 1,
                "description": "Subtitle in meta.subtitle_language"
              },
              "delay_s": {
                "type": "number",
                "minimum": 0
              },
              "keep_pace": {
                "type": "boolean",
                "description": "Exempt this line from pace normalisation (deliberately slow lines)"
              }
            }
          },
          "use_style_reference": {
            "type": "boolean",
            "description": "Condition this keyframe on the style reference image (default true)"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "model",
        "caption",
        "bpm",
        "key",
        "duration_s",
        "candidates",
        "cues"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "chosen": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Index of the chosen candidate"
        },
        "choice_reason": {
          "type": "string"
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            },
            "music_gain_db": {
              "type": "number"
            }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "at_shot": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "lines",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    }
  }
}